# development | production (production enables Gin release mode and secure cookies by default)
APP_ENV=development

# Go API port and Bun dev-server port (local, non-container use)
PORT=8080
WEB_PORT=5173

# Host port published by Docker Compose. The container always listens on 8080.
HOST_PORT=8001

# Image used by Docker Compose. Set this on the server to pull from GHCR:
# IMAGE=ghcr.io/your-github-user/attack-mode:latest

# SQLite database file. Parent directories are created automatically.
DB_PATH=./data/attack.db

# At least 8 characters. Change this before exposing the app to a network.
APP_PASSWORD=change-this-password

# Set to true when served over HTTPS. Defaults to true when APP_ENV=production.
COOKIE_SECURE=false

# Session lifetime in hours (720 = 30 days)
SESSION_TTL_HOURS=720

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For header is
# trusted. Leave empty when the app is exposed directly. In Docker behind Caddy
# or Nginx, set this to the proxy's address or Docker network (e.g. 172.16.0.0/12).
TRUSTED_PROXIES=
